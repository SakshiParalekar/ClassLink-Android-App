<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backnew"
    android:padding="20dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">


        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to ClassLink 👋"
            android:textSize="30sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="10dp"/>


        <!-- Create Class Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create New Class"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:textColor="#3F51B5" />


        <EditText
            android:id="@+id/classNameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="Enter Class Name"
            android:textColorHint="@color/greyText"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/greyText" />

        <TextView
            android:id="@+id/stdformat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" e.g CollegeName_Class"
            android:textSize="16sp"
            android:textColor="@color/greyText"
            android:layout_marginTop="2dp"
            android:layout_gravity="left"/>


        <Button
            android:id="@+id/createClassButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Class"
            android:layout_marginTop="12dp"
            android:backgroundTint="#3F51B5"
            android:textColor="#FFFFFF" />


        <TextView
            android:id="@+id/generatedCodeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generated Code will appear here"
            android:textSize="16sp"
            android:textColor="#D42DF0"
            android:layout_marginTop="12dp" />


        <Button
            android:id="@+id/shareCodeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share Class Code"
            android:layout_marginTop="8dp"
            android:backgroundTint="#6A7C90"
            android:textColor="#FFFFFF"/>


        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="24dp" />


        <!-- Join Class Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join Existing Class"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3F51B5" />


        <EditText
            android:id="@+id/joinCodeEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Class Code"
            android:inputType="text"
            android:textColor="@color/greyText"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:textColorHint="@color/greyText"
            android:background="@android:drawable/edit_text" />


        <Button
            android:id="@+id/joinButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Join Now"
            android:layout_marginTop="12dp"
            android:backgroundTint="#009688"
            android:textColor="#FFFFFF" />


    </LinearLayout>
</ScrollView>
