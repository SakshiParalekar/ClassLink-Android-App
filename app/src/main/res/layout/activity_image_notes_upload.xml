<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@color/lightBlue"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ImageNotesUploadActivity">


    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Image Note 📎"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"/>


        <TextView
            android:id="@+id/subjectLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Subject"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textColor="@color/black" />


        <!-- Subject Selection Row: Spinner + Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">


            <Spinner
                android:id="@+id/subjectSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/spinner_background"
                android:textColorHint="@color/black"
                android:padding="12dp" />


            <ImageView
                android:id="@+id/addSubjectBtn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginStart="8dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_add"
                android:contentDescription="Add Subject"></ImageView>

            <ImageView
                android:id="@+id/deleteSubjectBtn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginStart="8dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="Delete Subject"
                android:visibility="gone" />



        </LinearLayout>


        <!-- Unit Selection Spinner -->
        <TextView
            android:id="@+id/unitLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Unit"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textColor="@color/black" />


        <!-- Unit Selection Row: Spinner + Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">


            <Spinner
                android:id="@+id/unitSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/spinner_background"
                android:textColorHint="@color/black"
                android:padding="12dp" />


            <ImageView
                android:id="@+id/addUnitBtn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginStart="8dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_add"
                android:contentDescription="Add Unit"></ImageView>

            <ImageView
                android:id="@+id/deleteUnitBtn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginStart="8dp"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="Delete Unit"
                android:visibility="gone" />
        </LinearLayout>




        <EditText
            android:id="@+id/imageNoteTitleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Note Title (e.g., Chapter 4 Diagrams)"
            android:inputType="text"
            android:textColorHint="@color/gray"
            android:padding="14dp"
            android:textColor="@color/black"
            android:background="@android:drawable/edit_text" />


        <!-- File Upload Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:background="@drawable/white_card"
            android:padding="16dp"
            android:elevation="4dp">


            <ImageView
                android:layout_width="100dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_image_folder" />


            <TextView
                android:layout_marginTop="12dp"
                android:text="Tap below to browse file"
                android:textColor="#444"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />


            <Button
                android:id="@+id/browseFileButton"
                android:text="Browse File"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/royalBlue"
                android:textColor="#FFFFFF"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>


        <TextView
            android:layout_width="260dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:text="Supported by:"
            android:textAlignment="center"
            android:textColor="#888888"
            android:textSize="18sp" />


        <TextView
            android:layout_width="260dp"
            android:layout_height="80dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/ic_logos"
            ></TextView>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(Max 15MB)"
            android:textAlignment="center"
            android:textColor="#888888"></TextView>


        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:visibility="gone" />


        <Button
            android:id="@+id/uploadImageNoteBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload Image Note"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/darkBlue"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>
