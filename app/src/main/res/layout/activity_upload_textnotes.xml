<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".UploadTextNotesActivity"
    android:background="@color/lightBlue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:text="Upload Your Notes 𓂃🖊"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="#000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Select how you'd like to share your knowledge."
            android:textSize="17sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Toggle Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:layout_height="wrap_content"
                android:id="@+id/textNoteBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Text Note"
                android:textSize="20dp"
                android:backgroundTint="@color/blue"
                android:textColor="#FFFFFF" />

            <Button
                android:layout_height="wrap_content"
                android:id="@+id/imageNoteBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Image Note"
                android:textSize="20dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#CCCCCC"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Text Note Section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/textNoteCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter Text Note Details"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:layout_marginBottom="12dp"/>

                <!-- Subject Selection Spinner -->
                <TextView
                    android:id="@+id/subjectLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Subject"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/black" />

                <!-- Subject Selection Row: Spinner + Add Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp">

                    <Spinner
                        android:id="@+id/subjectSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_background"
                        android:padding="12dp"
                        android:textColor="#000000" />

                    <ImageView
                        android:id="@+id/addSubjectBtn"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_marginStart="8dp"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Add Subject"></ImageView>

                    <ImageView
                        android:id="@+id/deleteSubjectBtn"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_marginStart="8dp"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_delete"
                        android:contentDescription="Delete Subject"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Unit Selection Spinner -->
                <TextView
                    android:id="@+id/unitLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Unit"
                    android:textSize="16sp"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/black" />

                <!-- Unit Selection Row: Spinner + Add Button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="#000000">

                    <Spinner
                        android:id="@+id/unitSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/spinner_background"
                        android:padding="12dp"
                        android:textColor="#000000"
                        />

                    <ImageView
                        android:id="@+id/addUnitBtn"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_marginStart="8dp"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:textColorHint="@color/black"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Add Unit"></ImageView>

                    <ImageView
                        android:id="@+id/deleteUnitBtn"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:layout_marginStart="8dp"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_delete"
                        android:contentDescription="Delete Unit"
                        android:visibility="gone" />
                </LinearLayout>


                <EditText
                    android:id="@+id/noteTitleEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Note Title (e.g., Chapter 1 Summary)"
                    android:textColorHint="@color/gray"
                    android:inputType="text"
                    android:textColor="@color/black"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"/>

                <EditText
                    android:id="@+id/noteDescriptionEditText"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:textColor="@color/gray"
                    android:hint="Type your note content here..."
                    android:inputType="textMultiLine"
                    android:gravity="top|start"
                    android:textColorHint="@color/gray"
                    android:maxLength="2000"
                    android:layout_marginTop="12dp"
                    android:padding="10dp"
                    android:background="@android:drawable/edit_text"/>

                <!-- Character counter below description -->
                <TextView
                    android:id="@+id/charCountTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/2000"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <!-- Purpose / Summary EditText -->
                <EditText
                    android:id="@+id/notePurposeEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tip / Summary (e.g., Only Formulas, Revision)"
                    android:inputType="text"
                    android:textColorHint="@color/gray"
                    android:background="@android:drawable/edit_text"
                    android:padding="10dp"
                    android:textColor="@color/gray"
                    android:layout_marginBottom="12dp" />

                <!-- Estimated Reading Time -->
                <TextView
                    android:id="@+id/readingTimeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Reading Time: 2-3 mins"
                    android:textSize="14sp"
                    android:textColor="#444444"
                    android:layout_marginBottom="16dp" />

                <!-- Upload Button -->
                <Button
                    android:id="@+id/submitTextNoteBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload Text Note"
                    android:backgroundTint="@color/yellow"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>